{
    "name": "three_oh_eight/seo",
    "description": "Thin SEO add-on for laravel/head: config defaults, Seoable models, Livewire hook, canonical stripping",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "illuminate/http": "^13.17",
        "illuminate/routing": "^13.17",
        "illuminate/support": "^13.17",
        "illuminate/view": "^13.17",
        "laravel/head": "~0.2.2"
    },
    "autoload": {
        "psr-4": {
            "ThreeOhEight\\Seo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ThreeOhEight\\Seo\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "livewire/livewire": "^4.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ThreeOhEight\\Seo\\SeoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
